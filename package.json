{
  "name": "openclaw-plugin-group-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && openclaw plugins build",
    "test": "node --experimental-strip-types --test src/model.test.ts",
    "validate": "openclaw plugins validate --json"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.11.4"
  },
  "dependencies": {
    "typebox": "^1.3.17"
  },
  "devDependencies": {
    "openclaw": "2026.11.4",
    "typescript": "7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": ">=2026.11.4"
    },
    "build": {
      "openclawVersion": "2026.11.4"
    }
  }
}
